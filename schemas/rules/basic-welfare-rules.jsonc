        "applicant_accommodation.applicant_hot_water_costs",
        "applicant_accommodation.applicant_cable_tv_costs"
      ],
      "columns": [
        {
          "column": "rent_total",
          "field": "applicant_accommodation.applicant_rent_total"
        },
        {
          "column": "heating_costs",
          "field": "applicant_accommodation.applicant_heating_cost_advance"
        },
        {
          "column": "hot_water_costs",
          "field": "applicant_accommodation.applicant_hot_water_costs"
        },
        {
          "column": "cable_tv_costs",
          "field": "applicant_accommodation.applicant_cable_tv_costs"
        }
      ],
      "transitions": [
        { "next_step": "step_applicant_accommodation_details" }
      ]
    },
    "step_applicant_accommodation_details": {
      "id": "step_applicant_accommodation_details",
      "title": "Accommodation Details",
      "fields": [
        "applicant_accommodation.applicant_accommodation_living_area",
        "applicant_accommodation.applicant_accommodation_number_of_rooms"
      ],
      "columns": [
        {
          "column": "living_area",
          "field": "applicant_accommodation.applicant_accommodation_living_area"
        },
        {
          "column": "number_of_rooms",
          "field": "applicant_accommodation.applicant_accommodation_number_of_rooms"
        }
      ],
      "transitions": [
        { "next_step": "step_applicant_heating" }
      ]
    },
    "step_applicant_heating": {
      "id": "step_applicant_heating",
      "title": "Heating Type",
      "fields": [
        "applicant_accommodation.applicant_heating_type"
      ],
      "columns": [
        {
          "column": "heating_type",
          "field": "applicant_accommodation.applicant_heating_type",
          "options": [
            "Sammelheizung",
            "Zentrale Warmwasserversorgung",
            "Gasheizung",
            "Nachtstromspeicher",
            "Ofenheizung"
          ]
        }
      ],
      "transitions": [
        { "next_step": "step_applicant_benefits_awaiting_decision" }
      ]
    },
    "step_applicant_benefits_awaiting_decision": {
      "id": "step_applicant_benefits_awaiting_decision",
      "title": "Pending Benefits",
      "description": "Have you applied for any benefits for which a decision is still pending?",
      "fields": [
        "income_information.benefits_awaiting_decision_details_applicant.has_applied_for_benefits_awaiting_decision"
      ],
      "columns": [
        {
          "column": "has_applied_for_benefits_awaiting_decision",
          "field": "income_information.benefits_awaiting_decision_details_applicant.has_applied_for_benefits_awaiting_decision"
        }
      ],
      "transitions": [
        {
          "condition": "income_information.benefits_awaiting_decision_details_applicant.has_applied_for_benefits_awaiting_decision = true",
          "next_step": "step_applicant_benefits_awaiting_decision_details"
        },
        { "next_step": "step_previous_benefits" }
      ]
    },
    "step_applicant_benefits_awaiting_decision_details": {
      "id": "step_applicant_benefits_awaiting_decision_details",
      "title": "Pending Benefits Details",
      "fields": [
        "income_information.benefits_awaiting_decision_details_applicant.benefits_awaiting_decision_type",
        "income_information.benefits_awaiting_decision_details_applicant.benefits_awaiting_decision_application_date",
        "income_information.benefits_awaiting_decision_details_applicant.benefits_awaiting_decision_office",
        "income_information.benefits_awaiting_decision_details_applicant.benefits_awaiting_decision_reference"
      ],
      "columns": [
        {
          "column": "benefits_awaiting_decision_type",
          "field": "income_information.benefits_awaiting_decision_details_applicant.benefits_awaiting_decision_type"
        },
        {
          "column": "benefits_awaiting_decision_application_date",
          "field": "income_information.benefits_awaiting_decision_details_applicant.benefits_awaiting_decision_application_date"
        },
        {
          "column": "benefits_awaiting_decision_office",
          "field": "income_information.benefits_awaiting_decision_details_applicant.benefits_awaiting_decision_office"
        },
        {
          "column": "benefits_awaiting_decision_reference",
          "field": "income_information.benefits_awaiting_decision_details_applicant.benefits_awaiting_decision_reference"
        }
      ],
      "transitions": [
        { "next_step": "step_previous_benefits" }
      ]
    },
    "step_previous_benefits": {
      "id": "step_previous_benefits",
      "title": "Have you received benefits before?",
      "fields": [
        "applicant_information.has_applicant_received_benefits_before"
      ],
      "columns": [
        {
          "column": "has_received_previous_benefits",
          "field": "applicant_information.has_applicant_received_benefits_before"
        }
      ],
      "transitions": [
        {
          "condition": "applicant_information.has_applicant_received_benefits_before = true",
          "next_step": "step_previous_benefits_details"
        },
        { "next_step": "step_applicant_pension" }
      ]
    },
    "step_previous_benefits_details": {
      "id": "step_previous_benefits_details",
      "title": "Previous Benefits Details",
      "fields": [
        "applicant_information.applicant_previous_benefits_end",
        "applicant_information.applicant_previous_benefits_authority",
        "applicant_information.applicant_previous_benefits_reference_number"
      ],
      "columns": [
        {
          "column": "previous_benefits_period",
          "field": "applicant_information.applicant_previous_benefits_end"
        },
        {
          "column": "previous_benefits_authority",
          "field": "applicant_information.applicant_previous_benefits_authority"
        },
        {
          "column": "previous_benefits_ref_no",
          "field": "applicant_information.applicant_previous_benefits_reference_number"
        }
      ],
      "transitions": [
        { "next_step": "step_applicant_pension" }
      ]
    },
    "step_applicant_pension": {
      "id": "step_applicant_pension",
      "title": "Pension Status",
      "description": "Which pensions do you receive, and how much per month?",
      "fields": [
        "income_information.income_information_applicant.income_applicant_details.income_pension"
      ],
      "columns": [
        {
          "income_type": "Old-Age Pension",
          "field": "income_information.income_information_applicant.income_applicant_details.income_pension"
        },
        {
          "income_type": "Reduced Earning Capacity Pension",
          "field": "income_information.income_information_applicant.income_applicant_details.income_pension"
        },
        {
          "income_type": "Survivor Pension",
          "field": "income_information.income_information_applicant.income_applicant_details.income_pension"
        }
      ],
      "transitions": [
        { "next_step": "step_applicant_employment" }
      ]
    },
    "step_applicant_employment": {
      "id": "step_applicant_employment",
      "title": "Are you currently employed?",
      "fields": [
        "applicant_earning_capacity.is_applicant_employed"
      ],
      "columns": [
        {
          "column": "is_currently_employed",
          "field": "applicant_earning_capacity.is_applicant_employed"
        }
      ],
      "effects": [
        {
          "type": "REQUIRE_DOCUMENT",
          "target": "Employment contract / proof of wages",
          "condition": "applicant_earning_capacity.is_applicant_employed = true"
        }
      ],
      "transitions": [
        {
          "condition": "applicant_earning_capacity.is_applicant_employed = true",
          "next_step": "step_applicant_employment_details"
        },
        { "next_step": "step_applicant_income_other" }
      ]
    },
    "step_applicant_employment_details": {
      "id": "step_applicant_employment_details",
      "title": "Employment Details",
      "fields": [
        "applicant_earning_capacity.applicant_occupation",
        "applicant_earning_capacity.applicant_employer",
        "income_information.income_information_applicant.income_applicant_details.income_non_self_employed"
      ],
      "columns": [
        {
          "column": "work_scope_and_type",
          "field": "applicant_earning_capacity.applicant_occupation"
        },
        {
          "column": "employer_name",
          "field": "applicant_earning_capacity.applicant_employer"
        },
        {
          "income_type": "Employment",
          "field": "income_information.income_information_applicant.income_applicant_details.income_non_self_employed"
        }
      ],
      "transitions": [
        { "next_step": "step_applicant_income_other" }
      ]
    },
    "step_applicant_income_other": {
      "id": "step_applicant_income_other",
      "title": "Other Income",
      "description": "Do you receive sick pay, maintenance or rental income? Leave empty what doesn't apply.",
      "fields": [
        "income_information.income_information_applicant.income_applicant_details.income_health_insurance_benefits",
        "income_information.income_information_applicant.income_applicant_details.income_alimony",
        "income_information.income_information_applicant.income_applicant_details.income_rental_income"
      ],
      "columns": [
        {
          "income_type": "Health Insurance Benefits",
          "field": "income_information.income_information_applicant.income_applicant_details.income_health_insurance_benefits"
        },
        {
          "income_type": "Alimony",
          "field": "income_information.income_information_applicant.income_applicant_details.income_alimony"
        },
        {
          "income_type": "Rental and Leasing",
          "field": "income_information.income_information_applicant.income_applicant_details.income_rental_income"
        }
      ],
      "transitions": [
        { "next_step": "step_applicant_expected_payments" }
      ]
    },
    "step_applicant_expected_payments": {
      "id": "step_applicant_expected_payments",
      "title": "Expected One-Time Payments",
      "description": "Are you expecting any significant one-time payments?",
      "fields": [
        "income_information['one-time_payments_expected_details_applicant']['are_one-time_payments_expected']"
      ],
      "columns": [
        {
          "column": "are_one_time_payments_expected",
          "field": "income_information['one-time_payments_expected_details_applicant']['are_one-time_payments_expected']"
        }
      ],
      "transitions": [
        {
          "condition": "income_information['one-time_payments_expected_details_applicant']['are_one-time_payments_expected'] = true",
          "next_step": "step_applicant_expected_payments_details"
        },
        { "next_step": "step_applicant_bank_details" }
      ]
    },
    "step_applicant_expected_payments_details": {
      "id": "step_applicant_expected_payments_details",
      "title": "Expected Payment Details",
      "fields": [
        "income_information['one-time_payments_expected_details_applicant']['one-time_payments_expected_type']",
        "income_information['one-time_payments_expected_details_applicant']['one-time_payments_expected_amount']",
        "income_information['one-time_payments_expected_details_applicant']['one-time_payments_expected_date']"
      ],
      "columns": [
        {
          "column": "one_time_payments_expected_type",
          "field": "income_information['one-time_payments_expected_details_applicant']['one-time_payments_expected_type']"
        },
        {
          "column": "one_time_payments_expected_amount",
          "field": "income_information['one-time_payments_expected_details_applicant']['one-time_payments_expected_amount']"
        },
        {
          "column": "one_time_payments_expected_date",
          "field": "income_information['one-time_payments_expected_details_applicant']['one-time_payments_expected_date']"
        }
      ],
      "transitions": [
        { "next_step": "step_applicant_bank_details" }
      ]
    },
    "step_applicant_bank_details": {
      "id": "step_applicant_bank_details",
      "title": "Bank Details",
      "fields": [
        "applicant_information.applicant_bank_details.bank_account_holder",
        "applicant_information.applicant_bank_details.bank_name",
        "applicant_information.applicant_bank_details.bank_account_number"
      ],
      "columns": [
        {
          "column": "account_holder",
          "field": "applicant_information.applicant_bank_details.bank_account_holder"
        },
        {
          "column": "bank_name",
          "field": "applicant_information.applicant_bank_details.bank_name"
        },
        {
          "column": "iban",
          "field": "applicant_information.applicant_bank_details.bank_account_number"
        },
        {
          "column": "bic",
          "optional": true
        }
      ],
      "effects": [
        {
          "type": "REQUIRE_DOCUMENT",
          "target": "Bank statements (last 3 months)"
        }
      ],
      "transitions": [
        { "next_step": "step_applicant_care_dependency" }
      ]
    },
    "step_applicant_care_dependency": {
      "id": "step_applicant_care_dependency",
      "title": "Care Dependency Status",
      "fields": [
        "applicant_earning_capacity.is_care_dependent"
      ],
      "columns": [
        {
          "column": "is_care_dependent",
          "field": "applicant_earning_capacity.is_care_dependent"
        }
      ],
      "effects": [
        {
          "type": "REQUIRE_DOCUMENT",
          "target": "care_level_notice",
          "condition": "applicant_earning_capacity.is_care_dependent = true"
        }
      ],
      "transitions": [
        {
          "condition": "applicant_earning_capacity.is_care_dependent = true",
          "next_step": "step_applicant_stationary_facility"
        },
        { "next_step": "step_applicant_reduced_earnings" }
      ]
    },
    "step_applicant_stationary_facility": {
      "id": "step_applicant_stationary_facility",
      "title": "Stationary Care Facility",
      "fields": [
        "applicant_earning_capacity.has_inpatient_facility_accommodation"
      ],
      "columns": [
        {
          "column": "has_inpatient_facility_accommodation",
          "field": "applicant_earning_capacity.has_inpatient_facility_accommodation"
        }
      ],
      "effects": [
        {
          "type": "REQUIRE_DOCUMENT",
          "target": "care_home_contract",
          "condition": "applicant_earning_capacity.has_inpatient_facility_accommodation = true"
        },
        {
          "type": "REQUIRE_DOCUMENT",
          "target": "care_facility_costs",
          "condition": "applicant_earning_capacity.has_inpatient_facility_accommodation = true"
        },
        {
          "type": "REQUIRE_DOCUMENT",
          "target": "care_service_invoice",
          "condition": "applicant_earning_capacity.has_inpatient_facility_accommodation = false"
        }
      ],
      "transitions": [
        {
          "condition": "applicant_earning_capacity.has_inpatient_facility_accommodation = true",
          "next_step": "step_applicant_stationary_facility_dates"
        },
        { "next_step": "step_applicant_reduced_earnings" }
      ]
    },
    "step_applicant_stationary_facility_dates": {
      "id": "step_applicant_stationary_facility_dates",
      "title": "Stationary Care Facility Move In Date",
      "fields": [
        "applicant_earning_capacity.inpatient_facility_move_in_date",
        "applicant_earning_capacity.inpatient_facility_last_residence"
      ],
      "columns": [
        {
          "column": "inpatient_facility_move_in_date",
          "field": "applicant_earning_capacity.inpatient_facility_move_in_date"
        },
        {
          "column": "inpatient_facility_last_residence",
          "field": "applicant_earning_capacity.inpatient_facility_last_residence"
        }
      ],
      "transitions": [
        { "next_step": "step_applicant_reduced_earnings" }
      ]
    },
    "step_applicant_reduced_earnings": {
      "id": "step_applicant_reduced_earnings",
      "title": "Reduced Earning Capacity",
      "fields": [
        "applicant_earning_capacity.ability_to_work"
      ],
      "columns": [
        {
          "column": "ability_to_work",
          "field": "applicant_earning_capacity.ability_to_work"
        }
      ],
      "transitions": [
        {
          "condition": "applicant_earning_capacity.ability_to_work = 'Permanently disabled'",
          "next_step": "step_applicant_reduced_earnings_permanent"
        },
        {
          "condition": "applicant_earning_capacity.ability_to_work = 'Temporarily disabled'",
          "next_step": "step_applicant_reduced_earnings_period"
        },
        { "next_step": "step_applicant_nutrition" }
      ]
    },
    "step_applicant_reduced_earnings_permanent": {
      "id": "step_applicant_reduced_earnings_permanent",
      "title": "Permanent Reduced Earning Capacity Details",
      "fields": [
        "applicant_earning_capacity.reduced_work_capacity_start_date",
        "applicant_earning_capacity.reduced_work_capacity_reason",
        "applicant_earning_capacity.has_disability_id"
      ],
      "columns": [
        {
          "column": "reduced_work_capacity_start_date",
          "field": "applicant_earning_capacity.reduced_work_capacity_start_date"
        },
        {
          "column": "reduced_work_capacity_reason",
          "field": "applicant_earning_capacity.reduced_work_capacity_reason"
        },
        {
          "column": "has_disability_id",
          "field": "applicant_earning_capacity.has_disability_id"
        }
      ],
      "effects": [
        {
          "type": "REQUIRE_DOCUMENT",
          "target": "pension_notice"
        },
        {
          "type": "REQUIRE_DOCUMENT",
          "target": "disability_id"
        }
      ],
      "transitions": [
        {
          "condition": "applicant_earning_capacity.has_disability_id = true",
          "next_step": "step_applicant_disability"
        },
        { "next_step": "step_applicant_nutrition" }
      ]
    },
    "step_applicant_reduced_earnings_period": {
      "id": "step_applicant_reduced_earnings_period",
      "title": "Temporary Reduced Earning Capacity Details",
      "fields": [
        "applicant_earning_capacity.reduced_work_capacity_start_date",
        "applicant_earning_capacity.reduced_work_capacity_end_date",
        "applicant_earning_capacity.reduced_work_capacity_reason"
      ],
      "columns": [
        {
          "column": "reduced_work_capacity_start_date",
          "field": "applicant_earning_capacity.reduced_work_capacity_start_date"
        },
        {
          "column": "reduced_work_capacity_end_date",
          "field": "applicant_earning_capacity.reduced_work_capacity_end_date"
        },
        {
          "column": "reduced_work_capacity_reason",
          "field": "applicant_earning_capacity.reduced_work_capacity_reason"
        }
      ],
      "transitions": [
        { "next_step": "step_applicant_nutrition" }
      ]
    },
    "step_applicant_disability": {
      "id": "step_applicant_disability",
      "title": "Severely Disabled Pass",
      "fields": [
        "applicant_earning_capacity.merkzeichen",
        "applicant_earning_capacity.disability_valid_until"
      ],
      "columns": [
        {
          "column": "merkzeichen",
          "field": "applicant_earning_capacity.merkzeichen"
        },
        {
          "column": "disability_valid_until",
          "field": "applicant_earning_capacity.disability_valid_until"
        }
      ],
      "transitions": [
        { "next_step": "step_applicant_nutrition" }
      ]
    },
    "step_applicant_nutrition": {
      "id": "step_applicant_nutrition",
      "title": "Costly Nutrition",
      "description": "Do you need a costly diet for medical reasons?",
      "fields": [
        "benefits_for_special_additional_needs.does_household_have_costly_nutrition_for_medical_reasons"
      ],
      "columns": [
        {
          "column": "has_costly_medical_nutrition",
          "field": "benefits_for_special_additional_needs.does_household_have_costly_nutrition_for_medical_reasons"
        }
      ],
      "transitions": [
        { "next_step": "END" }
      ]
    }
  }
}
