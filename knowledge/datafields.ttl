    rdfs:comment "Du findest sie auf jedem Schreiben der Familienkasse. Sie besteht aus drei Ziffern, den Buchstaben FK und sechs weiteren Ziffern."@de ,
        "You can find it on every letter from the Familienkasse. It consists of three digits, the letters FK and six more digits."@en .

bf:iban a bf:DataField ;
    bf:appliesTo bf:Citizen ;
    bf:datatype bf:text ;
    bf:section bf:sectionBank ;
    bf:questionPriority 1 ;
    bf:storedAs "iban" ;
    rdfs:label "IBAN"@de , "IBAN"@en ;
    schema:question "Auf welches Konto soll das Geld überwiesen werden? Bitte gib die IBAN ein."@de , "Which account should the money be paid into? Please enter the IBAN."@en ;
    rdfs:comment "Die IBAN steht auf Deiner Bankkarte oder im Online-Banking. Deutsche IBANs beginnen mit DE und haben 22 Zeichen."@de ,
        "The IBAN is on your bank card or in online banking. German IBANs start with DE and have 22 characters."@en .

