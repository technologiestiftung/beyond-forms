bf:maritalStatus a bf:DataField ;
    bf:appliesTo bf:Citizen ;
    bf:datatype bf:selection ;
    bf:section bf:sectionFamily ;
    bf:questionPriority 5 ;
    bf:storedAs "marital_status" ;
    rdfs:label "Familienstand"@de , "Marital status"@en ;
    schema:question "Was ist Dein Familienstand?"@de , "What is your marital status?"@en ;
    bf:answerOptions ( bf:maritalStatus-single bf:maritalStatus-married bf:maritalStatus-registeredPartnership bf:maritalStatus-separated bf:maritalStatus-divorced bf:maritalStatus-widowed ) .

bf:maritalStatus-single a bf:AnswerOption ; bf:code "SINGLE" ; bf:storedValue "Single" ; rdfs:label "Ledig"@de , "Single"@en .
bf:maritalStatus-married a bf:AnswerOption ; bf:code "MARRIED" ; bf:storedValue "Married" ; bf:hasStartDate true ;
    rdfs:label "Verheiratet"@de , "Married"@en .
bf:maritalStatus-registeredPartnership a bf:AnswerOption ; bf:code "REGISTERED_CIVIL_PARTNERSHIP" ; bf:storedValue "Registered Civil Partnership" ; bf:hasStartDate true ;
    rdfs:label "In eingetragener Lebenspartnerschaft"@de , "In a registered civil partnership"@en .
bf:maritalStatus-separated a bf:AnswerOption ; bf:code "PERMANENTLY_SEPARATED" ; bf:storedValue "Permanently Separated" ; bf:hasStartDate true ;
    rdfs:label "Dauernd getrennt lebend"@de , "Permanently separated"@en .
bf:maritalStatus-divorced a bf:AnswerOption ; bf:code "DIVORCED" ; bf:storedValue "Divorced" ; rdfs:label "Geschieden"@de , "Divorced"@en .
bf:maritalStatus-widowed a bf:AnswerOption ; bf:code "WIDOWED" ; bf:storedValue "Widowed" ; rdfs:label "Verwitwet"@de , "Widowed"@en .

