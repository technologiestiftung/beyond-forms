@prefix bf: <https://beyond-forms.example/ns#> .
@prefix ff: <https://foerderfunke.org/default#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

bf:kinderzuschlag a bf:RequirementProfile ;
    rdfs:label "Kinderzuschlag"@de , "Child supplement (Kinderzuschlag)"@en ;
    bf:leikaId "99107016017000" ;
    bf:legalBasis bf:bkgg ;
    bf:providingAgency bf:familienkasse ;
    bf:eligibleReasonKey "gross_above_minimum" ;
    bf:eligibleReason "Dein Bruttoeinkommen erreicht das Mindesteinkommen für den Kinderzuschlag."@de ,
        "Your gross income reaches the minimum income for the child supplement."@en ;
    skos:closeMatch ff:kzl ;
    bf:hasMainShape bf:kinderzuschlagShape .

bf:kinderzuschlagShape a sh:NodeShape ;
    sh:targetClass bf:Citizen ;
    sh:property [
        sh:path bf:livesInGermany ; sh:minCount 1 ; sh:in ( true ) ;
        sh:order 0 ; bf:reasonKey "not_living_in_germany" ;
        sh:message "Du wohnst nicht in Deutschland."@de , "You do not live in Germany."@en
    ] ;
    sh:property [
        sh:path bf:hasChildUnder25 ; sh:minCount 1 ; sh:in ( true ) ;
        sh:order 1 ; bf:reasonKey "no_children" ;
        sh:message "In Deinem Haushalt leben keine Kinder unter 25 Jahren."@de , "No children under 25 live in your household."@en
    ] ;
    sh:property [
        sh:path bf:kizMinimumIncomeReached ; sh:minCount 1 ; sh:in ( true ) ;
        sh:order 2 ; bf:reasonKey "gross_below_minimum" ;
        sh:message "Dein Bruttoeinkommen liegt unter dem Mindesteinkommen für den Kinderzuschlag."@de , "Your gross income is below the minimum income for the child supplement."@en
    ] ;
    sh:property [
        sh:path bf:residenceStatusAnswered ; sh:minCount 1
    ] .
