@prefix bf: <https://beyond-forms.example/ns#> .
@prefix ff: <https://foerderfunke.org/default#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

bf:grundsicherungsgeld a bf:RequirementProfile ;
    rdfs:label "Grundsicherungsgeld"@de , "Basic income support (Grundsicherungsgeld)"@en ;
    # Still listed as "Bürgergeld Bewilligung" in the FIM LeiKa code list version 20260703; no separate key for the Grundsicherungsgeld
    bf:leikaId "99107108017000" ;
    bf:legalBasis bf:sgb-ii ;
    bf:providingAgency bf:jobcenter ;
    bf:eligibleReasonKey "income_below_needs" ;
    bf:eligibleReason "Dein Einkommen reicht nicht für Deinen Bedarf inklusive Miete."@de ,
        "Your income does not cover your needs including rent."@en ;
    skos:closeMatch ff:bgd ;
    bf:hasMainShape bf:grundsicherungsgeldShape .

bf:grundsicherungsgeldShape a sh:NodeShape ;
    sh:targetClass bf:Citizen ;
    sh:property [
        sh:path bf:livesInGermany ; sh:minCount 1 ; sh:in ( true ) ;
        sh:order 0 ; bf:reasonKey "not_living_in_germany" ;
        sh:message "Du wohnst nicht in Deutschland."@de , "You do not live in Germany."@en
    ] ;
    sh:property [
        sh:path bf:hasReachedRetirementAge ; sh:minCount 1 ; sh:in ( false ) ;
        sh:order 1 ; bf:reasonKey "retirement_age_reached" ;
        sh:message "Du hast die Regelaltersgrenze erreicht."@de , "You have reached the standard retirement age."@en
    ] ;
    sh:property [
        sh:path bf:workCapacity ; sh:minCount 1 ; sh:in ( bf:workCapacity-full bf:workCapacity-temporarilyReduced ) ;
        sh:order 2 ; bf:reasonKey "permanently_unable_to_work" ;
        sh:message "Du kannst dauerhaft weniger als drei Stunden am Tag arbeiten."@de , "You can permanently work less than three hours a day."@en
    ] ;
    sh:property [
        sh:path bf:incomeCoversNeeds ; sh:minCount 1 ; sh:in ( false ) ;
        sh:order 3 ; bf:reasonKey "income_covers_needs" ;
        sh:message "Dein Einkommen deckt Deinen Bedarf inklusive Miete."@de , "Your income covers your needs including rent."@en
    ] ;
    sh:property [
        sh:path bf:assetsWithinAllowanceSgb2 ; sh:minCount 1 ; sh:in ( true ) ;
        sh:order 4 ; bf:reasonKey "assets_too_high" ;
        sh:message "Deine Ersparnisse liegen über dem Betrag, den Du behalten darfst."@de , "Your savings are above the amount you may keep."@en
    ] ;
    sh:property [
        sh:path bf:residenceStatusAnswered ; sh:minCount 1
    ] .
